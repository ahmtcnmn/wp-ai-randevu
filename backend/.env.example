# ============================================================
# AppointFlow Backend — Environment Variables
# Bu dosyayi `.env` olarak kopyalayip degerleri doldur.
# ============================================================

# ─── Spring Boot ────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ─── Database (PostgreSQL) ──────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appointflow_db
DB_USERNAME=postgres
DB_PASSWORD=

# ─── Redis (refresh token + quota counter + 2FA temp token) ─
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ────────────────────────────────────────────────────
# PROD: minimum 256-bit (32+ karakter) random secret
JWT_SECRET=appointflow-super-secret-key-must-be-at-least-256-bits-long-for-HS256
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ─── CORS ───────────────────────────────────────────────────
# Virgülle ayrılmış origin listesi
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── OpenAI (AI Asistan) ────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048
OPENAI_TIMEOUT_SECONDS=30

# ─── WhatsApp Business API ──────────────────────────────────
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TIMESTAMP_TOLERANCE=300

# ─── Iyzico (Odeme) ─────────────────────────────────────────
IYZICO_API_KEY=sandbox-3qBYqNy2GTaDsdovxccV1AkSgMjmSGer
IYZICO_SECRET_KEY=sandbox-Ad9Ms7yis9Ik1Dt1icOqY7Pras91qIZ7
IYZICO_BASE_URL=https://api.iyzipay.com
IYZICO_WEBHOOK_SECRET=
IYZICO_DEV_MODE=false
IYZICO_STRICT_BUYER_INFO=false
IYZICO_CALLBACK_URL=http://localhost:8080/api/v1/billing/iyzico-callback
IYZICO_FRONTEND_CALLBACK_URL=http://localhost:3000/billing/callback

# ─── Mail / SMTP (Sprint 1 — sifre reset, email dogrulama) ──
# Dev'de false ise mail icerigi log'a yazilir
APP_MAIL_ENABLED=false
APP_MAIL_FROM=no-reply@appointflow.com
# Spring Mail config (APP_MAIL_ENABLED=true ise zorunlu)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# ─── Sifre Sifirlama (Sprint 1) ─────────────────────────────
APP_PASSWORD_RESET_TTL_MINUTES=60
APP_PASSWORD_RESET_URL=http://localhost:3000/reset-password?token=

# ─── Email Dogrulama (Sprint 1) ─────────────────────────────
APP_EMAIL_VERIFICATION_TTL_HOURS=48
APP_EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email?token=

# ─── Push Notification (Sprint 3 — Expo) ────────────────────
# false ise push gonderim log'a yazilir
APP_PUSH_ENABLED=false

# ─── 2FA (Sprint 7) ─────────────────────────────────────────
# QR code "issuer" alani — authenticator app'te hesap basligi
APP_TWO_FACTOR_ISSUER=AppointFlow

# ─── Sentry (hata izleme) ───────────────────────────────────
SENTRY_DSN=

# ============================================================
# PRODUCTION CHECKLIST:
# [ ] JWT_SECRET: random 32+ char (cuid/uuid yapistir)
# [ ] DB_PASSWORD: strong password
# [ ] REDIS_PASSWORD: zorunlu
# [ ] CORS_ALLOWED_ORIGINS: prod domain (mobil app icin de gerekli)
# [ ] OPENAI_API_KEY: dolu
# [ ] WHATSAPP_*: dolu
# [ ] IYZICO_*: production key + IYZICO_STRICT_BUYER_INFO=true
# [ ] APP_MAIL_ENABLED=true + SMTP creds
# [ ] APP_PASSWORD_RESET_URL: https://appointflow.com/reset-password?token=
# [ ] APP_EMAIL_VERIFICATION_URL: https://appointflow.com/verify-email?token=
# [ ] APP_PUSH_ENABLED=true (mobil push icin)
# [ ] SENTRY_DSN: dolu (hata izleme)
# ============================================================
